<div class="container game-container">
    <div class="row">
        <div class="col-md-12">
            <h1>Tower of Hanoi</h1>
            <p class="game-description">
                Move all disks from the first peg to the last peg. Only move one disk at a time, and never place a larger disk on top of a smaller one.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div id="tower-of-hanoi-board" class="game-board"></div>
            <div id="tower-of-hanoi-controls" class="game-controls"></div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Game Rules</h4>
                </div>
                <div class="card-body">
                    <ol>
                        <li>Move all disks from the first peg to the last peg.</li>
                        <li>Only one disk can be moved at a time.</li>
                        <li>No disk may be placed on top of a smaller disk.</li>
                        <li>The game supports both 3 and 4 peg configurations.</li>
                        <li>Try to solve the puzzle in the minimum number of moves!</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Algorithms</h4>
                </div>
                <div class="card-body">
                    <p>The Tower of Hanoi puzzle can be solved using different algorithms:</p>
                    <ul>
                        <li><strong>Recursive Solution:</strong> The classical approach using recursion. Optimal for 3 pegs.</li>
                        <li><strong>Iterative Solution:</strong> Non-recursive approach useful for large disk counts to avoid stack overflow.</li>
                        <li><strong>Frame-Stewart Algorithm:</strong> An improved solution specifically for the 4-peg variant.</li>
                    </ul>
                    <p>You can click "Show Solution" to see an animation of the selected algorithm solving the current configuration.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Initialize game using ES modules -->
<script type="module">
    import { TowerOfHanoiUI } from '/src/games/towerOfHanoi/ui/index.js';
    import TowerOfHanoi from '/src/games/towerOfHanoi/game.js';
    
    document.addEventListener('DOMContentLoaded', async () => {
        const game = new TowerOfHanoi();
        const ui = new TowerOfHanoiUI();
        await ui.initialize(game, 'tower-of-hanoi-board', 'tower-of-hanoi-controls');
    });
</script>