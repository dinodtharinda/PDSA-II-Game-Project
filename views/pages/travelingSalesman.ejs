<!-- Traveling Salesman Problem Game -->

<div class="container my-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-3">Traveling Salesman Problem</h1>
            
            <div class="alert alert-primary" role="alert">
                <h4 class="alert-heading">Game Instructions:</h4>
                <p>Find the shortest route that visits each city exactly once, starting and ending at the home city.</p>
                <p>The distances between cities are randomly assigned between 50-100 km. The home city is also randomly selected for each game round.</p>
                <hr>
                <p class="mb-0"><strong>Click on cities</strong> to build your route, or use the algorithm buttons to find solutions automatically.</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-9">
            <!-- Canvas for city visualization and route drawing -->
            <div class="canvas-container" style="position: relative; height: 500px; background-color: #f8f9fa; border-radius: 10px; overflow: hidden;">
                <canvas id="tsp-canvas" style="width: 100%; height: 100%;"></canvas>
                
                <!-- City information overlay -->
                <div class="canvas-info" style="position: absolute; top: 10px; left: 10px; padding: 10px; background-color: rgba(255,255,255,0.8); border-radius: 5px;">
                    <p class="mb-1"><strong>Home City:</strong> <span id="home-city"></span></p>
                    <p class="mb-1"><strong>Current Route:</strong> <span id="selected-route"></span></p>
                    <p class="mb-1"><strong>Distance:</strong> <span id="route-distance">0 km</span></p>
                    <p class="mb-0" id="unvisited-cities"></p>
                </div>
            </div>
            
            <!-- Message area -->
            <div id="tsp-message" class="message-area my-3"></div>
            
            <!-- City selection container -->
            <div class="city-selection mt-4">
                <h4 class="mb-3">Select Cities to Visit</h4>
                <div id="city-container" class="d-flex flex-wrap justify-content-center gap-2"></div>
            </div>
        </div>
        
        <div class="col-md-3">
            <!-- Controls and algorithm selection -->
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Game Controls</h5>
                </div>
                <div class="card-body">
                    <button id="reset-game" class="btn btn-danger btn-block mb-3 w-100">Reset Game</button>
                    
                    <h6 class="border-bottom pb-2 mb-3">Algorithms</h6>
                    
                    <div class="d-grid gap-2">
                        <button id="nn-algorithm" class="btn btn-primary">Nearest Neighbor</button>
                        <button id="dp-algorithm" class="btn btn-danger">Dynamic Programming</button>
                        <button id="ga-algorithm" class="btn btn-success">Genetic Algorithm</button>
                        <button id="compare-algorithms" class="btn btn-dark mt-2">Compare All</button>
                    </div>
                </div>
            </div>
            
            <!-- Algorithm description -->
            <div class="card mt-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Algorithm Complexity</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nearest Neighbor:</strong> O(n²)</p>
                    <p><strong>Dynamic Programming:</strong> O(n²·2ⁿ)</p>
                    <p><strong>Genetic Algorithm:</strong> O(gen·pop·n²)</p>
                    <p class="mb-0"><small>n = number of cities, gen = generations, pop = population size</small></p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Algorithm results section -->
    <div class="row mt-4">
        <div class="col-12">
            <h3>Algorithm Results</h3>
            <div id="algorithm-results" class="algorithm-results"></div>
        </div>
    </div>
</div>

<!-- Custom styles for TSP game -->
<% contentFor('styles', function() { %>
<style>
    .city-node {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #6c757d;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .city-node:hover {
        transform: scale(1.1);
    }
    
    .city-node.home-city {
        background-color: #007bff;
        width: 60px;
        height: 60px;
        box-shadow: 0 0 10px rgba(0, 123, 255, 0.5);
    }
    
    .city-node.selected {
        background-color: #28a745;
        transform: scale(1.05);
    }
    
    .algorithm-result {
        margin-bottom: 20px;
    }
    
    .performance-metrics {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
        padding: 10px;
        background-color: #f8f9fa;
        border-radius: 5px;
    }
    
    .metric {
        text-align: center;
    }
    
    .message-info {
        background-color: #cce5ff;
        border: 1px solid #b8daff;
        color: #004085;
    }
    
    .message-success {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
    }
    
    .message-warning {
        background-color: #fff3cd;
        border: 1px solid #ffeeba;
        color: #856404;
    }
    
    .message-error {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
        .canvas-container {
            height: 350px;
        }
        
        .canvas-info {
            font-size: 0.8rem;
        }
    }
</style>
<% }) %>

<!-- Initialize game using ES modules -->
<% contentFor('scripts', function() { %>
<script type="module">
    import TSPUI from '/src/games/tsp/ui/index.js';
    
    document.addEventListener('DOMContentLoaded', async () => {
        // Get player ID from session or localStorage if available
        const playerId = localStorage.getItem('playerId') || 
                         sessionStorage.getItem('playerId') || 
                         '<%= locals.playerId || "" %>';
                         
        // Create UI with player ID
        const ui = new TSPUI(playerId || null);
        ui.init();
        
        // Create metrics container for tracking performance
        const controlsColumn = document.querySelector('.col-md-3');
        if (controlsColumn) {
            const metricsContainer = document.createElement('div');
            metricsContainer.id = 'metrics-container';
            metricsContainer.className = 'mt-4';
            controlsColumn.appendChild(metricsContainer);
        }
    });
</script>
<% }) %>