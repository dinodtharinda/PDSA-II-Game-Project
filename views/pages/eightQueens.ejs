<%- contentFor('body') %>
<% gameStyles = true %>

<div class="container game-container">
    <div class="row">
        <div class="col-md-12">
            <h1>Eight Queens Puzzle</h1>
            <p class="game-description">
                Place eight queens on a chessboard so that no two queens threaten each other. That means no two queens should share the same row, column, or diagonal.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div id="queens-board" class="game-board"></div>
            <div id="queens-controls" class="game-controls"></div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Game Rules</h4>
                </div>
                <div class="card-body">
                    <ul>
                        <li>Click on any square to place a queen</li>
                        <li>Click on a queen to remove it</li>
                        <li>Red highlights show squares under attack</li>
                        <li>Place all eight queens without any conflicts</li>
                        <li>There are 92 possible solutions!</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Algorithms</h4>
                </div>
                <div class="card-body">
                    <p>This puzzle can be solved using different algorithmic approaches:</p>
                    <ul>
                        <li><strong>Sequential Algorithm:</strong> A systematic approach that tries each valid position in sequence.</li>
                        <li><strong>Threaded Algorithm:</strong> A parallel processing approach that explores multiple board states simultaneously.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Load game bundle -->
<script src="/js/eightQueens.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize game
        initEightQueens();
    });
    
    function initEightQueens() {
        const gameUI = new EightQueensUI();
        gameUI.initialize('queens-board', 'queens-controls').catch(console.error);
    }
</script>
