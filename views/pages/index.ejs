        </div>
      </div>
    </div>
    
    <div class="col-md-4 mb-4">
      <div class="card game-card">
        <img src="/images/tsp.svg" class="card-img-top game-card-img" alt="Traveling Salesman Problem">
        <div class="card-body">
          <h5 class="card-title game-card-title">Traveling Salesman</h5>
          <p class="card-text">Find the shortest route through cities using Nearest Neighbor, Dynamic Programming, and Genetic Algorithms.</p>
          <a href="/traveling-salesman" class="btn btn-game">Solve Puzzle</a>
        </div>
      </div>
    </div>
    
    <div class="col-md-4 mb-4">
      <div class="card game-card">
