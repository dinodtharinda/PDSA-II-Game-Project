<%- contentFor('body') %>

<div class="container game-container">
    <div class="row">
        <div class="col-md-12">
            <h1>Tic Tac Toe</h1>
            <p class="game-description">
                Play against the computer on a 5x5 grid. Get four in a row horizontally, vertically, or diagonally to win!
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div id="tic-tac-toe-board" class="game-board"></div>
            <div id="tic-tac-toe-controls" class="game-controls"></div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Game Rules</h4>
                </div>
                <div class="card-body">
                    <ul>
                        <li>You play as X, computer plays as O</li>
                        <li>Players take turns placing their symbol on empty cells</li>
                        <li>Get four symbols in a row (horizontally, vertically, or diagonally) to win</li>
                        <li>The game ends in a draw if all cells are filled without a winner</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Algorithms</h4>
                </div>
                <div class="card-body">
                    <p>The computer uses advanced algorithms to determine its moves:</p>
                    <ul>
                        <li><strong>Minimax Algorithm:</strong> A recursive algorithm that simulates all possible moves to find the optimal play.</li>
                        <li><strong>Monte Carlo Tree Search:</strong> An alternative approach that uses random simulations to evaluate moves.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Initialize game using ES modules -->
<script type="module">
    import { TicTacToeUI } from '/src/games/ticTacToe/ui/index.js';
    
    document.addEventListener('DOMContentLoaded', async () => {
        // Load game styles through Vite
        const gameStyles = document.createElement('link');
        gameStyles.rel = 'stylesheet';
        gameStyles.href = '/src/games/ticTacToe/styles/game.css';
        document.head.appendChild(gameStyles);
        
        // Get player ID from session or localStorage if available
        const playerId = localStorage.getItem('playerId') || 
                         sessionStorage.getItem('playerId') || 
                         '<%= locals.playerId || "" %>';
                         
        const gameUI = new TicTacToeUI(playerId || null);
        await gameUI.initialize('tic-tac-toe-board', 'tic-tac-toe-controls');
    });
</script>