<% gameStyles = true %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<div class="container game-container">
    <div class="row">
        <div class="col-md-12">
            <h1>Knight's Tour Problem</h1>
            <p class="game-description">
                Find a sequence of moves for a knight to visit every square on an 8×8 chessboard exactly once. 
                You can start from a random position or use the "Solve" button to see algorithmic solutions.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div id="knights-tour-board" class="game-board"></div>
        </div>
        <div class="col-md-4">
            <div id="knights-tour-controls" class="game-controls">
                <!-- All controls will be dynamically generated by JavaScript -->
                <!-- No static controls here to avoid duplicates -->
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Game Rules</h4>
                </div>
                <div class="card-body">
                    <ul>
                        <li>The knight must visit each square exactly once</li>
                        <li>The knight moves in an L-shape pattern (2 squares in one direction, then 1 square perpendicular)</li>
                        <li>Click on a valid square (highlighted) to make your move</li>
                        <li>Try to visit all 64 squares of the chessboard</li>
                        <li>Use the "Solve" button to see an algorithmic solution</li>
                        <li>Compare the performance of Backtracking vs. Warnsdorff's Algorithm</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Algorithms</h4>
                </div>
                <div class="card-body">
                    <h5>Backtracking Algorithm</h5>
                    <p>
                        This algorithm uses a recursive approach to find a Knight's Tour by trying all possible 
                        moves at each step. If a move leads to an invalid tour, it backtracks and tries another move.
                        <span class="performance-indicator performance-slow">Slower</span>
                    </p>
                    
                    <h5>Warnsdorff's Algorithm</h5>
                    <p>
                        This heuristic algorithm prioritizes moves based on the number of onward moves available 
                        from each candidate position. It always chooses the move with the fewest onward options,
                        which helps the knight avoid getting trapped.
                        <span class="performance-indicator performance-fast">Faster</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<% contentFor('scripts', function() { %>
<script type="module">
    import { KnightsTour } from '/src/games/knightsTour/game.js';
    import { KnightsTourUI } from '/src/games/knightsTour/ui/index.js';

    document.addEventListener('DOMContentLoaded', async () => {
        const game = new KnightsTour();
        const ui = new KnightsTourUI();
        await ui.initialize(game);
    });
</script>
<% }) %>