<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="PDSA-II Game Project - Interactive algorithm visualizations">
  <meta name="author" content="PDSA-II Team">
  <title><%= typeof title !== 'undefined' ? title : 'Home' %> | PDSA-II Game Project</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Base styles -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/games.css">
  
  <%# Render content defined in the 'head' block from page templates %>
</head>
<body>
  <!-- Navigation -->
  <%- include('../partials/navigation') %>

  <!-- Main Content -->
  <main class="main-content container my-4">
    <%# Render the main body content from the page template %>
    <%- body %> 
  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- Bootstrap Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <% if (process.env.NODE_ENV === 'development') { %>
    <!-- Vite HMR support in development -->
    <script type="module" src="/@vite/client"></script>
  <% } %>
  
  <%# Render scripts defined using contentFor('scripts') - Keep for other pages %>
  <%- defineContent('scripts') %> 

  <%# Render page-specific scripts passed from the route %>
  <% if (typeof pageScripts !== 'undefined' && Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(scriptPath => { %>
      <script type="module" src="<%= scriptPath %>"></script>
    <% }); %>
  <% } %>
</body>
</html>