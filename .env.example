# Application
NODE_ENV=development
PORT=3000

# Session configuration
SESSION_SECRET=secret
SESSION_NAME=game_session

# Database configuration
DB_PATH=database/game.db

# Logging configuration
LOG_LEVEL=degug
LOG_DIR=logs

# Game settings
MAX_GAME_TIME=3600  # Maximum game duration in seconds
MAX_MOVES=1000      # Maximum moves allowed per game